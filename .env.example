# ============================================================
# BIG DATA CLASSIFICATION AND PREDICTION FOR TRANSPORTATION AND LOGISTICS USING APACHE HIVE
# Environment Configuration Template
#
# USAGE:
#   cp .env.example .env
#   Then edit .env with your actual values.
#   NEVER commit .env to version control.
# ============================================================

# --- Flask Application ---
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_SECRET_KEY=change_this_to_a_long_random_string_in_production
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# --- Storage Mode ---
# local  → uses data/ directory on your machine (no Hadoop needed)
# hdfs   → uses HDFS cluster (requires Hadoop setup)
STORAGE_MODE=local

# --- Spark Mode ---
# local  → PySpark runs on your machine using all available CPU cores
# cluster → connects to a remote Spark cluster
SPARK_MODE=local
SPARK_MASTER=local[*]
# SPARK_MASTER=spark://your-spark-master:7077   # for cluster mode

# --- MongoDB ---
# Default: connects to MongoDB on localhost (no auth)
# Production: use a full URI with username/password
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=logistics_bdt

# --- HDFS Configuration ---
# Only required when STORAGE_MODE=hdfs
HDFS_HOST=localhost
HDFS_PORT=9000
HDFS_USER=hdfs
HDFS_BASE_PATH=/logistics

# --- File Upload Settings ---
MAX_UPLOAD_MB=50
ALLOWED_EXTENSIONS=csv

# --- Machine Learning ---
MODEL_DIR=data/models
MODEL_VERSION=rf_v1.0
RANDOM_STATE=42

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

